{
  "name": "task-cli",
  "version": "1.0.0",
  "description": "CLI personal de gestión de tareas con persistencia local en SQLite",
  "type": "commonjs",
  "bin": {
    "task-cli": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cli",
    "tasks",
    "sqlite"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
